# 1. Strict noindex on WordPress backend
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# 2. If visitor reaches Hostinger on the main domain (cached DNS), forward to Vercel storefront
RewriteCond %{HTTP_HOST} ^(www\.)?abeautynfashion\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/wp-json [NC]
RewriteCond %{REQUEST_URI} !^/graphql [NC]
RewriteCond %{REQUEST_URI} !^/wp-admin [NC]
RewriteCond %{REQUEST_URI} !^/wp-login\.php [NC]
RewriteRule ^(.*)$ https://beautynfashion-wp.vercel.app/$1 [R=302,L]

# 3. If visitor reaches admin.abeautynfashion.com root, redirect to wp-admin
RewriteCond %{HTTP_HOST} ^admin\.abeautynfashion\.com$ [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^$ /wp-admin/ [R=302,L]
</IfModule>

# BEGIN LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteRule litespeed/debug/.*\.log$ - [F,L]
RewriteRule (^|/)\.litespeed_conf\. - [F,L]
</IfModule>
<IfModule LiteSpeed>
CacheLookup on
RewriteRule .* - [E=Cache-Control:no-autoflush]

### marker ASYNC start ###
RewriteCond %{REQUEST_URI} /wp-admin/admin-ajax\.php
RewriteCond %{QUERY_STRING} action=async_litespeed
RewriteRule .* - [E=noabort:1]
### marker ASYNC end ###

### marker REST AUTH start ###
RewriteCond %{HTTP:Authorization} !^$
RewriteCond %{REQUEST_URI} /wp\-json(?:/|$) [OR]
RewriteCond %{QUERY_STRING} (^|&)rest_route=
RewriteRule .* - [E=Cache-Control:no-cache]
### marker REST AUTH end ###

### marker POSTPASS start ###
RewriteCond %{HTTP_COOKIE} (^|;\s*)wp-postpass_36bc250c7d26b8ed265389bd0f988a47=
RewriteRule .* - [E=Cache-Control:no-cache]
### marker POSTPASS end ###

### marker LOGIN COOKIE start ###
RewriteRule .? - [E="Cache-Vary:woocommerce_cart_hash"]
### marker LOGIN COOKIE end ###

### marker DROPQS start ###
CacheKeyModify -qs:fbclid
CacheKeyModify -qs:gclid
CacheKeyModify -qs:utm*
CacheKeyModify -qs:_ga
### marker DROPQS end ###

</IfModule>
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END LSCACHE

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
